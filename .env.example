# 외부 호출용 API 키 (X-API-Key 헤더와 비교)
# 평가 도구가 보내는 키와 동일하게 맞추세요. 실제 값은 .env에만 넣고 커밋 금지.
RAG_API_KEY=change-me

# Bedrock (팀 서버 리전: 오사카)
BEDROCK_REGION=ap-northeast-3
EMBED_MODEL_ID=amazon.titan-embed-text-v2:0
# 이 리전은 raw 모델 ID가 아닌 inference profile ID로만 호출됩니다.
GEN_MODEL_ID=global.anthropic.claude-haiku-4-5-20251001-v1:0

# S3 (원본 PDF 보관). 버킷을 다른 백엔드와 공유하므로 uploads/ 아래로.
S3_BUCKET=hackathon-e3-t05-data
S3_RAW_PREFIX=uploads/

# 청킹
CHUNK_SIZE=800
CHUNK_OVERLAP=100

# 업로드 제한 (bytes). 기본 20MB
MAX_UPLOAD_BYTES=20971520

# 로컬 인덱스 저장 경로
DATA_DIR=data

# 주의: AWS 자격증명은 여기에 넣지 않습니다.
# 서버 IAM 역할(hackathon-e3-t05-ec2-role)의 기본 자격증명 체인을 사용합니다.
